# Module 2 reads these from the environment (PowerShell: $env:NAME = "value"; persist with setx NAME "value").
# fixture = offline scripted incident (default, used by CI); live = your running lab
OBS_BACKEND=fixture
OBS_FIXTURE_SCENARIO=checkout-latency
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
SPLUNK_URL=https://localhost:8090
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=ShopSphere#Lab1
SPLUNK_VERIFY_TLS=false
SHOP_URL=http://localhost:8080
# Claude for the investigator agent
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5-5
