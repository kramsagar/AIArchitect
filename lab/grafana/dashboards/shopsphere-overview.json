   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(shopsphere:http_errors:ratio_rate1h{service_name=\"shopsphere-shop\"}) / 0.005",
     "legendFormat": "burn",
     "refId": "A",
     "exemplar": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "x"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   }
  },
